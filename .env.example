# ─────────────────────────────────────────────────────────────────────────────
# StwDO Dorm Monitor Bot — Environment Variables Template
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Applicant Personal Data ───────────────────────────────────────────────────
APPLICANT_FIRST_NAME=Max
APPLICANT_LAST_NAME=Mustermann
APPLICANT_EMAIL=max.mustermann@example.com
APPLICANT_PHONE=+491701234567

# Optional: matriculation number (Matrikelnummer) if the form asks for it
APPLICANT_MATRIKEL=1234567

# ── Alert Channels (choose ANY ONE or more — sab optional hain) ───────────────

# ✅ OPTION 1 — ntfy.sh (SABSE AASAAN — No account needed!)
# Step 1: Phone pe "ntfy" app install karo (Play Store / App Store)
# Step 2: Apna unique topic naam yahan likho (koi bhi naam)
# Step 3: App mein same topic subscribe karo — bas ho gaya!
NTFY_TOPIC=my-secret-dorm-topic-12345
# NTFY_SERVER=https://ntfy.sh   # default — change only if self-hosted

# ✅ OPTION 2 — Discord Webhook (bohot aasaan)
# Discord mein koi channel kholo → Settings → Integrations → Webhooks → Copy URL
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXXX/YYYY

# ✅ OPTION 3 — Gmail Email Alert
# Gmail → Google Account → Security → 2-Step Verification ON karo
# Phir: App Passwords → "Mail" select karo → 16-char password copy karo
# ALERT_EMAIL_FROM=aapki.gmail@gmail.com
# ALERT_EMAIL_TO=aapki.gmail@gmail.com
# ALERT_EMAIL_PASS=abcd efgh ijkl mnop   # 16-char App Password (spaces theek hain)

# ✅ OPTION 4 — Telegram (agar setup karna ho)
# 1. @BotFather se /newbot karo → TOKEN copy karo
# 2. Bot ko koi message bhejo → https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. JSON mein "chat":{"id":...} dhundo — woh CHAT_ID hai
# TELEGRAM_BOT_TOKEN=123456789:AABBccDDeeFfGgHhIiJjKkLlMmNnOoPpQq
# TELEGRAM_CHAT_ID=987654321


# ── Polling Configuration ─────────────────────────────────────────────────────
# How often to check the listings page (seconds). Default: 30
POLLING_INTERVAL_SECONDS=30

# Maximum time the bot will run per session (minutes). Default: 90
MAX_RUNTIME_MINUTES=90

# ── Target URL ────────────────────────────────────────────────────────────────
# The page listing available rooms. Do not change unless StwDO restructures.
LISTINGS_URL=https://www.stwdo.de/wohnen/aktuelle-wohnangebote

# ── Browser Configuration ─────────────────────────────────────────────────────
# Set to "true" to run browser in visible mode (useful for local debugging).
HEADLESS=true

# ── Anti-Bot Configuration ────────────────────────────────────────────────────
# Minimum and maximum random delay (ms) injected between human-like actions.
MIN_ACTION_DELAY_MS=300
MAX_ACTION_DELAY_MS=1200
